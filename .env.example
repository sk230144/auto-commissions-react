# Auto Commissions — React
#
# Copy this file to .env for local development. Vite only exposes variables
# prefixed VITE_ to client code; never commit real values.

# Where the DEV proxy forwards to. Not used in production: there the target is
# the URL inside vercel.json's rewrite, so change it there when the API moves.
#   staging: http://66.42.90.20:28975
VITE_API_BASE_URL=

# Path prefix every endpoint sits behind. Only change this if the API is
# re-versioned (e.g. /api/commission/v2).
VITE_API_PREFIX=/api/commission/v1

# Bearer token. Auth is disabled on staging — leave blank there. When the API
# turns auth on, put the JWT here and the client sends it automatically.
VITE_API_TOKEN=

# Milliseconds before a request is aborted.
VITE_API_TIMEOUT_MS=20000

# The API sends no CORS headers, so requests go through a same-origin proxy
# (Vite in dev, vercel.json in production). Set to "false" ONLY once the API
# sends CORS headers, to call VITE_API_BASE_URL directly instead.
VITE_USE_PROXY=true
